          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"entityName\": \"Usuario\",\n  \"packageName\": \"com.example.usuario\",\n  \"database\": \"H2\",\n  \"port\": 8092,\n  \"outputDirectory\": \"{{outputDirectory}}/usuario-h2\",\n  \"fields\": [\n    { \"name\": \"nome\",  \"type\": \"STRING\", \"required\": true,  \"maxLength\": 150 },\n    { \"name\": \"email\", \"type\": \"STRING\", \"required\": true,  \"maxLength\": 255 },\n    { \"name\": \"cpf\",   \"type\": \"STRING\", \"required\": true,  \"maxLength\": 14  },\n    { \"name\": \"ativo\", \"type\": \"BOOLEAN\",\"required\": false }\n  ],\n  \"children\": [\n    {\n      \"entityName\": \"Endereco\",\n      \"fields\": [\n        { \"name\": \"logradouro\", \"type\": \"STRING\",  \"required\": true,  \"maxLength\": 200 },\n        { \"name\": \"numero\",     \"type\": \"STRING\",  \"required\": true,  \"maxLength\": 10  },\n        { \"name\": \"cep\",        \"type\": \"STRING\",  \"required\": true,  \"maxLength\": 10  },\n        { \"name\": \"cidade\",     \"type\": \"STRING\",  \"required\": true,  \"maxLength\": 100 },\n        { \"name\": \"estado\",     \"type\": \"STRING\",  \"required\": true,  \"maxLength\": 2   },\n        { \"name\": \"principal\",  \"type\": \"BOOLEAN\", \"required\": false }\n      ]\n    },\n    {\n      \"entityName\": \"Telefone\",\n      \"fields\": [\n        { \"name\": \"numero\", \"type\": \"STRING\", \"required\": true,  \"maxLength\": 20 },\n        { \"name\": \"tipo\",   \"type\": \"STRING\", \"required\": true,  \"maxLength\": 20 }\n      ]\n    }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/generate", "host": ["{{baseUrl}}"], "path": ["api", "generate"] }
          }
        }
      ]

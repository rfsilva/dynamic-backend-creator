{
  "info": {
    "_postman_id": "a1b2c3d4-0002-4000-8000-jcodemodel-col",
    "name": "jcodemodel - CRUD Generator",
    "description": "Testa o endpoint POST /api/generate que gera aplicações CRUD via JCodeModel.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Generate - H2 (sem filhos)",
      "item": [
        {
          "name": "Product - H2 (simples)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('entityName correto', () => pm.expect(pm.response.json().entityName).to.eql('Product'));",
                  "pm.test('generatedFiles não vazio', () => pm.expect(pm.response.json().generatedFiles).to.not.be.empty);",
                  "pm.test('gerou README.md', () => pm.expect(pm.response.json().generatedFiles.join(',')).to.include('README.md'));",
                  "pm.test('gerou .gitignore', () => pm.expect(pm.response.json().generatedFiles.join(',')).to.include('.gitignore'));",
                  "pm.test('gerou postman/product.collection.json', () => pm.expect(pm.response.json().generatedFiles.join(',')).to.include('postman/product.collection.json'));",
                  "if (pm.response.code === 201) pm.environment.set('lastOutputDirectory', pm.response.json().outputDirectory);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"entityName\": \"Product\",\n  \"packageName\": \"com.example.product\",\n  \"database\": \"H2\",\n  \"port\": 8090,\n  \"outputDirectory\": \"{{outputDirectory}}/product-h2\",\n  \"fields\": [\n    { \"name\": \"name\",        \"type\": \"STRING\",          \"required\": true,  \"maxLength\": 150 },\n    { \"name\": \"description\", \"type\": \"STRING\",          \"required\": false, \"maxLength\": 500 },\n    { \"name\": \"price\",       \"type\": \"BIG_DECIMAL\",     \"required\": true  },\n    { \"name\": \"quantity\",    \"type\": \"INTEGER\",         \"required\": true  },\n    { \"name\": \"active\",      \"type\": \"BOOLEAN\",         \"required\": false },\n    { \"name\": \"createdAt\",   \"type\": \"LOCAL_DATE_TIME\", \"required\": false }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/generate", "host": ["{{baseUrl}}"], "path": ["api", "generate"] }
          }
        }
      ]
    },
    {
      "name": "Generate - Com filhos (one-to-many)",
      "item": [
        {
          "name": "SalesOrder → OrderItem (H2)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('entityName SalesOrder', () => pm.expect(pm.response.json().entityName).to.eql('SalesOrder'));",
                  "pm.test('gerou arquivos do filho', () => {",
                  "    const files = pm.response.json().generatedFiles.join(',');",
                  "    pm.expect(files).to.include('OrderItem');",
                  "});",
                  "pm.test('gerou postman/salesorder.collection.json', () => pm.expect(pm.response.json().generatedFiles.join(',')).to.include('postman/salesorder.collection.json'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"entityName\": \"SalesOrder\",\n  \"packageName\": \"com.example.sales\",\n  \"database\": \"H2\",\n  \"port\": 8091,\n  \"outputDirectory\": \"{{outputDirectory}}/salesorder-h2\",\n  \"fields\": [\n    { \"name\": \"customerName\", \"type\": \"STRING\",          \"required\": true,  \"maxLength\": 200 },\n    { \"name\": \"orderDate\",    \"type\": \"LOCAL_DATE\",      \"required\": true  },\n    { \"name\": \"totalAmount\",  \"type\": \"BIG_DECIMAL\",     \"required\": false },\n    { \"name\": \"status\",       \"type\": \"STRING\",          \"required\": true,  \"maxLength\": 50  }\n  ],\n  \"children\": [\n    {\n      \"entityName\": \"OrderItem\",\n      \"fields\": [\n        { \"name\": \"productName\", \"type\": \"STRING\",      \"required\": true,  \"maxLength\": 150 },\n        { \"name\": \"quantity\",    \"type\": \"INTEGER\",     \"required\": true  },\n        { \"name\": \"unitPrice\",   \"type\": \"BIG_DECIMAL\", \"required\": true  },\n        { \"name\": \"discount\",    \"type\": \"DOUBLE\",      \"required\": false }\n      ]\n    }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/generate", "host": ["{{baseUrl}}"], "path": ["api", "generate"] }
          }
        },

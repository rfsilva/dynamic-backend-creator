{
  "info": {
    "_postman_id": "a1b2c3d4-0002-4000-8000-jcodemodel-col",
    "name": "jcodemodel - CRUD Generator",
    "description": "Testa o endpoint POST /api/generate que gera aplicações CRUD via JCodeModel.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Generate",
      "item": [
        {
          "name": "Gerar CRUD - Product (exemplo completo)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Body contém entityName', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.entityName).to.eql('Product');",
                  "});",
                  "",
                  "pm.test('generatedFiles não está vazio', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.generatedFiles).to.be.an('array').that.is.not.empty;",
                  "});",
                  "",
                  "pm.test('outputDirectory está presente', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.outputDirectory).to.be.a('string').and.not.empty;",
                  "});",
                  "",
                  "if (pm.response.code === 201) {",
                  "    const json = pm.response.json();",
                  "    pm.environment.set('lastOutputDirectory', json.outputDirectory);",
                  "    console.log('Arquivos gerados:', json.generatedFiles.join('\\n'));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"entityName\": \"Product\",\n  \"packageName\": \"com.example.product\",\n  \"outputDirectory\": \"{{outputDirectory}}/product\",\n  \"fields\": [\n    { \"name\": \"name\",        \"type\": \"STRING\",           \"required\": true,  \"maxLength\": 150 },\n    { \"name\": \"description\", \"type\": \"STRING\",           \"required\": false, \"maxLength\": 500 },\n    { \"name\": \"price\",       \"type\": \"BIG_DECIMAL\",      \"required\": true  },\n    { \"name\": \"quantity\",    \"type\": \"INTEGER\",          \"required\": true  },\n    { \"name\": \"active\",      \"type\": \"BOOLEAN\",          \"required\": false },\n    { \"name\": \"createdAt\",   \"type\": \"LOCAL_DATE_TIME\",  \"required\": false },\n    { \"name\": \"expiresOn\",   \"type\": \"LOCAL_DATE\",       \"required\": false }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/generate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "generate"]
            },
            "description": "Gera CRUD completo para a entidade Product com vários tipos de campo."
          }
        },
